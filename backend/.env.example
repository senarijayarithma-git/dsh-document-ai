# Application environment: development, test, or production
APP_ENV=development

﻿# Example configuration only. Never put real passwords here.

DATABASE_URL=postgresql+psycopg://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE

# Set a unique random secret in your private .env file.
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173